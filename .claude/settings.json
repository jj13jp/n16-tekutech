{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(ls *)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)",
      "Bash(pn lint:*)",
      "Bash(pn format:*)",
      "Bash(pn test:*)",
      "Bash(pn typecheck:*)",
      "Bash(pn build:*)",
      "WebSearch"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout -- :*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm i:*)",
      "Bash(pn add:*)",
      "Bash(pn install:*)",
      "Bash(pn i:*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm remove:*)",
      "Bash(npm rm:*)",
      "Bash(npm un:*)",
      "Bash(npm r:*)",
      "Bash(npm unlink:*)",
      "Bash(pnpm uninstall:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm rm:*)",
      "Bash(pnpm un:*)",
      "Bash(pnpm unlink:*)",
      "Bash(pn uninstall:*)",
      "Bash(pn remove:*)",
      "Bash(pn rm:*)",
      "Bash(pn un:*)",
      "Bash(pn unlink:*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Edit(**/pnpm-lock.yaml)",
      "Write(**/pnpm-lock.yaml)",
      "Edit(**/biome.json)",
      "Write(**/biome.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm format"
          },
          {
            "type": "command",
            "command": "pnpm lint"
          }
        ]
      }
    ]
  }
}